{
  "openapi": "3.0.0",
  "info": {
    "title": "Webhook API",
    "version": "1.0.0",
    "description": "API para recebimento de webhooks da Evolution API."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "paths": {
    "/webhook/evolution": {
      "post": {
        "summary": "Recebe eventos de webhook da Evolution API",
        "description": "Processa eventos da Evolution API, especificamente mensagens recebidas (messages.upsert). Salva mensagens de números alvo no banco de dados.",
        "tags": [
          "Webhook"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "instance": {
                    "type": "string",
                    "description": "Nome da instância na Evolution API",
                    "example": "MinhaInstancia"
                  },
                  "event": {
                    "type": "string",
                    "description": "Tipo do evento disparado pela Evolution API",
                    "example": "messages.upsert"
                  },
                  "data": {
                    "type": "object",
                    "description": "Dados do evento. A estrutura varia conforme o tipo do evento."
                  }
                },
                "required": [
                  "instance",
                  "event",
                  "data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook processado com sucesso (ou evento ignorado intencionalmente)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ao processar o webhook",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Erro interno"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Lista produtos extraídos",
        "description": "Retorna os produtos salvos no banco de dados. Permite filtragem dinâmica por qualquer campo, incluindo busca por nome da categoria.",
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "categoria",
            "in": "query",
            "description": "Filtra por nome da categoria (ex: Smartphone, Smartwatch)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "description": "Filtra pelo ID da categoria",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "modelo",
            "in": "query",
            "description": "Filtra por modelo (ex: iPhone 13)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "versao",
            "in": "query",
            "description": "Filtra por versão",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "armazenamento",
            "in": "query",
            "description": "Filtra por armazenamento",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cor",
            "in": "query",
            "description": "Filtra por cor",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "saude_bateria",
            "in": "query",
            "description": "Filtra por saúde da bateria",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "preco",
            "in": "query",
            "description": "Filtra por preço",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "observacoes",
            "in": "query",
            "description": "Filtra por observações (ex: Seminovo)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remoteJid",
            "in": "query",
            "description": "Filtra pelo número do fornecedor",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "description": "Filtra apenas os ativos (true) ou inativos (false)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "condicao",
            "in": "query",
            "description": "Filtra por condição (Novo ou Seminovo)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Número da página (padrão: 1)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Quantidade de itens por página (padrão: 20)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de produtos retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "count": {
                      "type": "integer",
                      "example": 10
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "categoryId": {
                            "type": "object",
                            "properties": {
                              "_id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          "modelo": {
                            "type": "string"
                          },
                          "versao": {
                            "type": "string"
                          },
                          "armazenamento": {
                            "type": "string"
                          },
                          "cor": {
                            "type": "string"
                          },
                          "saude_bateria": {
                            "type": "string"
                          },
                          "condicao": {
                            "type": "string"
                          },
                          "preco": {
                            "type": "string"
                          },
                          "observacoes": {
                            "type": "string"
                          },
                          "groupName": {
                            "type": "string"
                          },
                          "groupJid": {
                            "type": "string"
                          },
                          "remoteJid": {
                            "type": "string"
                          },
                          "active": {
                            "type": "boolean"
                          },
                          "timestamp": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "totalCount": {
                      "type": "integer",
                      "example": 100
                    },
                    "totalPages": {
                      "type": "integer",
                      "example": 5
                    },
                    "currentPage": {
                      "type": "integer",
                      "example": 1
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Lista todas as categorias criadas",
        "description": "Retorna todas as categorias existentes no banco de dados.",
        "tags": [
          "Categories"
        ],
        "responses": {
          "200": {
            "description": "Lista de categorias",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "_id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login de usuário",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "401": {
            "description": "Não autorizado"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Registrar novo usuário",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Erro de validação"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout de usuário (encerra sessão ativa)",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "401": {
            "description": "Não autorizado"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}