{
  "openapi": "3.0.0",
  "info": {
    "title": "Webhook API",
    "version": "1.0.0",
    "description": "API para recebimento de webhooks da Evolution API."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "paths": {
    "/webhook/evolution": {
      "post": {
        "summary": "Recebe eventos de webhook da Evolution API",
        "description": "Processa eventos da Evolution API, especificamente mensagens recebidas (messages.upsert). Salva mensagens de números alvo no banco de dados.",
        "tags": [
          "Webhook"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "instance": {
                    "type": "string",
                    "description": "Nome da instância na Evolution API",
                    "example": "MinhaInstancia"
                  },
                  "event": {
                    "type": "string",
                    "description": "Tipo do evento disparado pela Evolution API",
                    "example": "messages.upsert"
                  },
                  "data": {
                    "type": "object",
                    "description": "Dados do evento. A estrutura varia conforme o tipo do evento."
                  }
                },
                "required": [
                  "instance",
                  "event",
                  "data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook processado com sucesso (ou evento ignorado intencionalmente)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ao processar o webhook",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Erro interno"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
